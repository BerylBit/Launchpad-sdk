{
  "version": "0.1.0",
  "name": "launchpad_core",
  "instructions": [
    {
      "name": "initializeGlobal",
      "accounts": [
        { "name": "admin", "isMut": true, "isSigner": true },
        { "name": "globalConfig", "isMut": true, "isSigner": false },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "params", "type": { "defined": "GlobalParams" } }
      ]
    },
    {
      "name": "createMarket",
      "accounts": [
        { "name": "payer", "isMut": true, "isSigner": true },
        { "name": "globalConfig", "isMut": false, "isSigner": false },
        { "name": "mint", "isMut": false, "isSigner": false },
        { "name": "market", "isMut": true, "isSigner": false },
        { "name": "tokenVault", "isMut": true, "isSigner": false },
        { "name": "solVault", "isMut": true, "isSigner": false },
        { "name": "tokenProgram", "isMut": false, "isSigner": false },
        { "name": "systemProgram", "isMut": false, "isSigner": false },
        { "name": "rent", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "params", "type": { "defined": "MarketParams" } }
      ]
    },
    {
      "name": "buy",
      "accounts": [
        { "name": "buyer", "isMut": true, "isSigner": true },
        { "name": "market", "isMut": true, "isSigner": false },
        { "name": "tokenVault", "isMut": true, "isSigner": false },
        { "name": "solVault", "isMut": true, "isSigner": false },
        { "name": "buyerTokenAccount", "isMut": true, "isSigner": false },
        { "name": "tokenProgram", "isMut": false, "isSigner": false },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "lamportsIn", "type": "u64" },
        { "name": "minTokensOut", "type": "u64" }
      ]
    },
    {
      "name": "sell",
      "accounts": [
        { "name": "seller", "isMut": true, "isSigner": true },
        { "name": "market", "isMut": true, "isSigner": false },
        { "name": "sellerTokenAccount", "isMut": true, "isSigner": false },
        { "name": "tokenVault", "isMut": true, "isSigner": false },
        { "name": "solVault", "isMut": true, "isSigner": false },
        { "name": "tokenProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "tokensIn", "type": "u64" },
        { "name": "minLamportsOut", "type": "u64" }
      ]
    },
    {
      "name": "graduate",
      "accounts": [
        { "name": "admin", "isMut": true, "isSigner": true },
        { "name": "market", "isMut": true, "isSigner": false }
      ],
      "args": []
    },
    {
      "name": "vaultSell",
      "accounts": [
        { "name": "keeper", "isMut": false, "isSigner": true },
        { "name": "market", "isMut": true, "isSigner": false },
        { "name": "treasury", "isMut": true, "isSigner": false },
        { "name": "creatorWallet", "isMut": true, "isSigner": false },
        { "name": "marketingWallet", "isMut": true, "isSigner": false },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "maxLamportsToSell", "type": "u64" },
        { "name": "nowTs", "type": "i64" },
        { "name": "recentVolumeLamports", "type": "u64" }
      ]
    }
  ],
  "accounts": [
    {
      "name": "GlobalConfig",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "admin", "type": "publicKey" },
          { "name": "treasury", "type": "publicKey" },
          { "name": "maxImpactBps", "type": "u16" },
          { "name": "maxBuyBpsOfReserve", "type": "u16" },
          { "name": "maxSellImpactBps", "type": "u16" },
          { "name": "minCooldownSecs", "type": "u32" },
          { "name": "bump", "type": "u8" }
        ]
      }
    },
    {
      "name": "Market",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "mint", "type": "publicKey" },
          { "name": "tokenVault", "type": "publicKey" },
          { "name": "solVault", "type": "publicKey" },

          { "name": "treasury", "type": "publicKey" },
          { "name": "creator", "type": "publicKey" },
          { "name": "marketing", "type": "publicKey" },

          { "name": "curveA", "type": "u64" },
          { "name": "curveB", "type": "u64" },

          { "name": "maxTradeImpactBps", "type": "u16" },
          { "name": "maxBuyBpsOfReserve", "type": "u16" },

          { "name": "sellCooldownSecs", "type": "u32" },
          { "name": "sellMaxImpactBps", "type": "u16" },
          { "name": "sellMaxPerCallLamports", "type": "u64" },
          { "name": "sellMinVolumeWindowLamports", "type": "u64" },

          { "name": "graduated", "type": "bool" },
          { "name": "lastSellTs", "type": "i64" },
          { "name": "bump", "type": "u8" }
        ]
      }
    }
  ],
  "types": [
    {
      "name": "GlobalParams",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "treasury", "type": "publicKey" },
          { "name": "maxImpactBps", "type": "u16" },
          { "name": "maxBuyBpsOfReserve", "type": "u16" },
          { "name": "maxSellImpactBps", "type": "u16" },
          { "name": "minCooldownSecs", "type": "u32" }
        ]
      }
    },
    {
      "name": "MarketParams",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "creator", "type": "publicKey" },
          { "name": "marketing", "type": "publicKey" },

          { "name": "curveA", "type": "u64" },
          { "name": "curveB", "type": "u64" },

          { "name": "maxTradeImpactBps", "type": "u16" },
          { "name": "maxBuyBpsOfReserve", "type": "u16" },

          { "name": "sellCooldownSecs", "type": "u32" },
          { "name": "sellMaxImpactBps", "type": "u16" },
          { "name": "sellMaxPerCallLamports", "type": "u64" },
          { "name": "sellMinVolumeWindowLamports", "type": "u64" }
        ]
      }
    }
  ],
  "errors": [
    { "code": 6000, "name": "InvalidAmount", "msg": "Invalid amount" },
    { "code": 6001, "name": "SlippageExceeded", "msg": "Slippage exceeded" },
    { "code": 6002, "name": "AlreadyGraduated", "msg": "Market already graduated" },
    { "code": 6003, "name": "BuyTooLarge", "msg": "Buy too large" },
    { "code": 6004, "name": "CooldownNotMet", "msg": "Cooldown not met" },
    { "code": 6005, "name": "VolumeTooLow", "msg": "Volume too low" }
  ]
}
